    { "id": "vskill.supabase-postgres-best-practices", "kind": "vendored-skill", "skill": "supabase-postgres-best-practices", "source": "supabase/agent-skills", "profiles": ["full", "standard", "lean", "minimal"], "description": "Postgres schema, index, RLS and query best practices." },
