# Environment variables. Copy to .env.local for local development (never commit .env.local).
# Values: Supabase dashboard > Project Settings > API.
# No local Supabase stack is needed: pnpm db:sync and pnpm db:test build the schema offline.
# Scope tags: [public] reaches the browser (NEXT_PUBLIC_ prefix), [server] stays on the server.
# Remote values live in Vercel (Preview and Production) and are set by a human.

# [public] Supabase API URL, for example https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# [public] Supabase publishable key (older projects: the anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# [server] Supabase secret key (older projects: service_role). Used only by src/server/supabase/admin.ts.
# Leave empty unless an approved spec requires admin access.
SUPABASE_SECRET_KEY=

# [public] Canonical site URL for auth redirects and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
